# LLM / RAG
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=your_api_key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
USE_LANGCHAIN_RAG=true
AUTO_BUILD_VECTOR_STORE=false

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=120
# Local tests keep this false for backward-compatible demo calls.
# Docker Compose sets it true so API routes require a Bearer token.
AUTH_ENFORCED=false

# Redis runtime
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120
SESSION_TTL_SECONDS=86400
CACHE_TTL_SECONDS=60

# Trace / retry / cost estimation
LOG_LEVEL=INFO
LLM_MAX_RETRIES=1
# Cost values are estimates. Keep at 0 when you do not want cost reporting.
LLM_PROMPT_COST_PER_1K=0
LLM_COMPLETION_COST_PER_1K=0

# Data backend
DATA_QUERY_BACKEND=sqlite

# Optional MySQL import scripts.
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=copilot_db

# Optional MySQL readonly query backend.
MYSQL_READONLY_USER=copilot_readonly
MYSQL_READONLY_PASSWORD=your_readonly_password
MYSQL_READONLY_HOST=127.0.0.1
MYSQL_READONLY_PORT=3306
MYSQL_READONLY_DATABASE=copilot_db

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# RAG 检索后端（v2）
# local = 自研（BM25 + 向量 + RRF，默认）；weknora = 腾讯开源 WeKnora 外部检索
RETRIEVAL_BACKEND=local
WEKNORA_BASE_URL=http://localhost:8080
WEKNORA_API_KEY=sk-xxx
WEKNORA_KB_ID=kb-xxx
